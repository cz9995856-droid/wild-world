# ---------------------------------------------------------------------------
# WILD WORLD · 环境变量示例
# 复制为 .env.local 后填入。所有密钥仅可在服务端读取。
# ---------------------------------------------------------------------------

# 站点
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=WILD WORLD

# 后台管理（必填才能登录 /admin；未设置时后台登录被禁用）
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_SESSION_SECRET=change-me-32-chars-minimum-secret
# 可选：管理员显示名与只读账号
ADMIN_EDITOR_PASSWORD=
ADMIN_VIEWER_PASSWORD=

# Supabase / PostgreSQL（可选。未配置时站点使用本地种子数据 + .data 文件仓库）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI 问答（可选。未配置时使用本地知识库检索模式，不伪造 AI 答案）
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# 新闻 RSS / 同步（服务端使用，无需密钥；可调整源）
NEWS_SYNC_ENABLED=true
NEWS_SYNC_MAX_ITEMS=120
NEWS_USER_AGENT=WILDWORLD-Museum/1.0 (+https://wildworld.example.org)

# 第三方数据接口（按需申请）
GBIF_API_BASE=https://api.gbif.org/v1
INATURALIST_API_BASE=https://api.inaturalist.org/v1
XENO_CANTO_API_KEY=
MACAULAY_LIBRARY_API_KEY=
IUCN_API_TOKEN=
SMITHSONIAN_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
WIKIMEDIA_CLIENT_ID=
WIKIMEDIA_CLIENT_SECRET=

# 首页影像（默认使用馆方用授权图片生成的循环短片；如需替换，请填写你有授权的视频直链）
NEXT_PUBLIC_HERO_VIDEO_URL=/media/hero/wild-world-loop.mp4
NEXT_PUBLIC_HERO_VIDEO_POSTER=/media/hero/hero-01.jpg
NEXT_PUBLIC_HERO_VIDEO_CREDIT=馆方剪辑 · 素材为馆藏授权影像，非野外实拍视频